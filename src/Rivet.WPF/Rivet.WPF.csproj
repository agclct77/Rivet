<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AssemblyName>Rivet.WPF</AssemblyName>
    <RootNamespace>Rivet.WPF</RootNamespace>
    <AssemblyTitle>Rivet WPF</AssemblyTitle>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company></Company>
    <Product>Rivet</Product>
    <Description>WPF UI for Rivet Clipboard Translation</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rivet.Service\Rivet.Service.csproj" />
    <ProjectReference Include="..\Rivet.Infrastructure\Rivet.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
